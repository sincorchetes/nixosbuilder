===== partition.sh =====
#!/usr/bin/env bash
# Generado por NixOSBuilder. REVÍSALO línea a línea antes de ejecutarlo como root:
# crea particiones y formatea. Los datos de lo que formatees se perderán.
set -euo pipefail

DISK=/dev/nvme0n1

# Borra la tabla de particiones y crea una GPT nueva.
sgdisk --zap-all "$DISK"
sgdisk -n 0:0:+1G -t 0:EF00 -c 0:esp "$DISK"
sgdisk -n 0:0:+8G -t 0:8200 -c 0:swap "$DISK"
sgdisk -n 0:0:0 -t 0:8309 -c 0:root "$DISK"
partprobe "$DISK"
udevadm settle

# Cifrado LUKS (pedirá la contraseña)
cryptsetup luksFormat /dev/disk/by-partlabel/root
cryptsetup open /dev/disk/by-partlabel/root crypt-root

# Sistemas de archivos
mkfs.fat -F 32 /dev/disk/by-partlabel/esp
mkswap -L swap /dev/disk/by-partlabel/swap
mkfs.btrfs -f -L root /dev/mapper/crypt-root

# Montaje en /mnt
mount --mkdir /dev/mapper/crypt-root /mnt
mount --mkdir -o umask=0077 /dev/disk/by-partlabel/esp /mnt/boot
swapon /dev/disk/by-partlabel/swap
"
`;

