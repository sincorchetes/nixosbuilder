}

===== filesystems.nix =====
{ ... }:
{
  boot.initrd.luks.devices."crypt-root" = {
    device = "/dev/disk/by-partlabel/root";
    allowDiscards = true;
  };
  fileSystems."/boot" = {
    device = "/dev/disk/by-partlabel/esp";
    fsType = "vfat";
    options = [ "umask=0077" ];
  };
  fileSystems."/" = {
    device = "/dev/mapper/crypt-root";
    fsType = "btrfs";
    options = [ "compress=zstd" "noatime" "discard=async" ];
  };
  swapDevices = [
    { device = "/dev/disk/by-partlabel/swap"; }
  ];
}

===== flake.nix =====
{
