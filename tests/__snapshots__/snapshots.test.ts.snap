# Aplicaciones del perfil "Gamer" (generado por NixOSBuilder).
# Añade o quita paquetes aquí. Lo que necesita configuración de sistema
# (Steam, Docker, servicios…) está en configuration.nix.
{ pkgs, ... }:
{
  environment.systemPackages = with pkgs; [
    # Plataformas
    heroic
    lutris
    bottles
    prismlauncher
    retroarch

    # Compatibilidad
    wine-staging
    winetricks
    protonup-qt

    # Rendimiento
    mangohud
    goverlay

    # Comunidad
    discord
    obs-studio
  ];
}
"
`;

